{
	"name": "StoneQR",
	"short_name": "StoneQR",
	"description": "Free QR code generator that runs in your browser. No sign-up, no expiry, nothing uploaded.",
	"id": "/",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#f4f0e8",
	"theme_color": "#f4f0e8",
	"icons": [
		{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{ "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	]
}
